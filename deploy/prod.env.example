# Modèle du .env de PRODUCTION.
# Ce fichier (avec des valeurs factices) peut être commité.
# Le vrai .env N'EST JAMAIS dans Git : il est stocké chiffré dans
# SSM Parameter Store (/solimus-vefa/backend/env) et récupéré à chaque déploiement.
#
# Règles : une variable par ligne, pas de guillemets, pas d'espace autour du "=".
# Si une valeur contient le caractère $, l'écrire $$.

# ---- Application ----
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8086
SERVER_SSL_ENABLED=false
SERVER_FORWARD_HEADERS_STRATEGY=framework
SWAGGER_ENABLED=false

# ---- Base de données (RDS) ----
# Mot de passe : aws ssm get-parameter --name /solimus-vefa/db/password --with-decryption --query Parameter.Value --output text
SPRING_DATASOURCE_URL=jdbc:mysql://solimus-vefa-db.cjkwcg6yqku4.eu-west-3.rds.amazonaws.com:3306/vefa?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=A_REMPLIR
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ---- Stockage des fichiers (S3, via le rôle IAM de l'EC2 : aucune clé) ----
STORAGE_TYPE=s3
FILES_BUCKET=solimus-vefa-files-374784204755-374784204755
AWS_REGION=eu-west-3
STORAGE_ENDPOINT=
STORAGE_PATH_STYLE=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- URL publiques ----
FRONT_URL=https://vefa.solimus.sn
API_URL=https://api.vefa.solimus.sn
ANGULAR_URL_SUCCESS=https://vefa.solimus.sn/A_REMPLIR
ANGULAR_URL_FAILED=https://vefa.solimus.sn/A_REMPLIR
PAYMENT_IPN_URL=https://api.vefa.solimus.sn/A_REMPLIR

# ---- E-mail (OVH) ----
SPRING_MAIL_HOST=ssl0.ovh.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=A_REMPLIR
SPRING_MAIL_PASSWORD=A_REMPLIR
OTP_TEST_EMAIL=

# ---- WhatsApp ----
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=A_REMPLIR
WHATSAPP_ACCESS_TOKEN=A_REMPLIR
WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_OTP_LANGUAGE=en
WHATSAPP_OTP_BUTTON_PARAMETER=123456
WHATSAPP_TEST_MODE=false
WHATSAPP_TEST_PHONE_NUMBER=
