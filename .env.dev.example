# Solimus Vefa - Development Environment Variables
# Copy this file to .env.dev and fill in the values for local development with Dokploy

# ====== APPLICATION CONFIGURATION ======
# Application port
SERVER_PORT=8082
# Spring profile to use
SPRING_PROFILES_ACTIVE=dev
# Front-end URL for CORS and redirects
FRONT_URL=https://dev-vefa.solimus.sn
API_URL=https://api-dev-vefa.solimus.sn
PAYMENT_IPN_URL=https://api-dev-vefa.solimus.sn/api/payment/ipn

# ====== DATABASE CONFIGURATION ======
# MySQL Database (Dokploy container)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/vefa
SPRING_DATASOURCE_USERNAME=solimus
MYSQL_ROOT_PASSWORD=root-password-change-this
MYSQL_PASSWORD=solimus-password-change-this
MYSQL_DATABASE=vefa
# DDL Auto mode for Hibernate (development: update, production: validate)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# SQL initialization mode
SPRING_SQL_INIT_MODE=never

# ====== FILE STORAGE - MinIO CONFIGURATION (DEVELOPMENT) ======
STORAGE_TYPE=minio
# MinIO runs in Dokploy stack at container name 'minio'
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PATH_STYLE=true
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
FILES_BUCKET=solimus
# MinIO public URL for signed URLs (accessible from frontend)
MINIO_URL=https://minio-dev-vefa.solimus.sn
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=solimus

# ====== AWS CONFIGURATION (for future migration) ======
AWS_REGION=eu-west-3

# ====== EMAIL CONFIGURATION ======
# SMTP settings for email notifications
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-email-password

# ====== WHATSAPP CONFIGURATION ======
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_OTP_LANGUAGE=en
WHATSAPP_OTP_BUTTON_PARAMETER=123456
WHATSAPP_TEST_MODE=false
WHATSAPP_TEST_PHONE_NUMBER=

# ====== OTP CONFIGURATION ======
OTP_TEST_EMAIL=test@example.com

# ====== ANGULAR FRONTEND URLs ======
ANGULAR_URL_SUCCESS=https://dev-vefa.solimus.sn/#/settings/accounts?status=success
ANGULAR_URL_FAILED=https://dev-vefa.solimus.sn/#/settings/accounts?status=failed

# ====== DOCUMENTATION ======
# Swagger/API documentation
SWAGGER_ENABLED=true

# ====== FLYWAY DATABASE MIGRATIONS ======
# Flyway will automatically run migrations from src/main/resources/db/migration on startup
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# ====== LOGGING ======
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG
LOGGING_LEVEL_COM_WAKANA_VEFA=DEBUG
